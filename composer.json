{
    "name": "challenge/dummy-json-users",
    "description": "Framework-agnostic user service for the DummyJSON API.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.4.1",
        "symfony/http-client": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        }
    },
    "autoload": {
        "psr-4": {
            "Challenge\\DummyJsonUsers\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Challenge\\DummyJsonUsers\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "test": "phpunit"
    }
}
